{
  "version": 2,
  "builds": [
    { "src": "lumera-web/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "server.js", "use": "@vercel/node", "config": { "includeFiles": "lumera-web/dist/**" } }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
