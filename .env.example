# Copy this file to .env and fill in your Supabase project details.
# Find both under Supabase: Project Settings -> API

SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key (NOT the anon/public key) — grants full server-side
# access, bypassing Row Level Security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign customer login tokens (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-random-64-char-hex-string

# Set all of these in your Vercel project's Environment Variables too.
